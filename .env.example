# Supabase — get these from your Supabase project dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Site
NEXT_PUBLIC_SITE_URL=https://listentruecrime.com

# Admin — comma-separated email addresses that get admin access
ADMIN_EMAILS=admin@listentruecrime.com

# Newsletter — set NEWSLETTER_PROVIDER to one of: sendgrid | beehiiv | convertkit | mailchimp | none
NEWSLETTER_PROVIDER=sendgrid

# SendGrid (default provider for Listen True Crime)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=info@listentruecrime.com
SENDGRID_FROM_NAME=Listen True Crime
SENDGRID_LIST_ID=
SENDGRID_UNSUBSCRIBE_GROUP_ID=
SENDGRID_WEBHOOK_VERIFICATION_KEY=

# Resend — powers the "Top 10 podcasts" lead magnet email (lib/email/lead-magnet.ts).
# Independent of NEWSLETTER_PROVIDER; only used when set.
RESEND_API_KEY=

# Beehiiv (if using Beehiiv)
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=

# ConvertKit (if using ConvertKit)
CONVERTKIT_API_KEY=
CONVERTKIT_FORM_ID=

# Mailchimp (if using Mailchimp)
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=
MAILCHIMP_SERVER_PREFIX=us1

# Podcast discovery automation (weekly GitHub Action — scripts/discovery/)
PODCASTINDEX_API_KEY=
PODCASTINDEX_API_SECRET=

# LLM-drafted newsletter blurb copy (weekly GitHub Action — scripts/discovery/)
ANTHROPIC_API_KEY=

# ─── Shop (merchandise store) — see SHOP_SYSTEM.md ──────────────────────────
# Everything below is OFF / empty by default. Set NEXT_PUBLIC_SHOP_ENABLED=true
# on Vercel *Preview* to review the shop before launch.
NEXT_PUBLIC_SHOP_ENABLED=false
SHOP_CHECKOUT_ENABLED=false
# Only honoured with a live Stripe key. Test-mode payments NEVER reach production.
SHOP_PRINTIFY_SEND_TO_PRODUCTION=false
SHOP_SUPPORT_EMAIL=
# Random 32+ char secret; also add as a GitHub Actions secret (retry job)
SHOP_CRON_SECRET=

# Stripe — start with TEST keys (sk_test_…)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Printify
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=
# Random 16+ char string you choose; passed to Printify when registering webhooks
PRINTIFY_WEBHOOK_SECRET=
